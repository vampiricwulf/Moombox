{
  "name": "moombox",
  "version": "1.5.2",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "package": "node scripts/build-sfx.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "youtube",
    "livestream",
    "archiver",
    "tui",
    "downloader"
  ],
  "author": "Wulf",
  "license": "MIT",
  "description": "YouTube Live Stream Archiver",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "astring": "^1.9.0",
    "compression": "^1.8.1",
    "envalid": "^8.1.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.3",
    "fs-extra": "^11.3.3",
    "ink": "^6.6.0",
    "jsdom": "^28.1.0",
    "lowdb": "^7.0.1",
    "lru-cache": "^11.2.4",
    "meriyah": "^7.0.0",
    "p-limit": "^7.3.0",
    "p-queue": "^9.1.0",
    "p-retry": "^7.1.1",
    "react": "^19.2.4",
    "smol-toml": "^1.6.0",
    "sql.js": "^1.14.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "esbuild": "^0.27.2",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
