{
  "comment": "One predicate, two languages: Go monitor.FailingChannels (over monitor.ChannelFailing) and utils.js failingChannels (over channelFailing), owner ruling R-H1. `monitors` is one platform's lists from the channelMonitors wire object, one list per monitor; `want` maps each failing channel ID to the entry shown for it. internal/monitor/channel_failing_parity_test.go runs the Go side and web/tests/channel-failing.test.mjs the dashboard's.",
  "cases": [
    { "name": "no monitors", "monitors": [], "want": {} },
    { "name": "one monitor, never failed", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "consecutiveErrors": 0 }]], "want": {} },
    { "name": "one monitor, two failures is under the streak", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 2 }]], "want": {} },
    { "name": "one monitor, three failures", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 3 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 3 } } },
    { "name": "one monitor, long streak", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "user not found", "consecutiveErrors": 40 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 1000, "lastError": "user not found", "consecutiveErrors": 40 } } },
    { "name": "two monitors, the other still reaches it", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 9 }], [{ "channelId": "a", "lastCheckedAt": 900, "consecutiveErrors": 0 }]], "want": {} },
    { "name": "two monitors, the other is under the streak", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 9 }], [{ "channelId": "a", "lastCheckedAt": 900, "lastError": "timeout", "consecutiveErrors": 2 }]], "want": {} },
    { "name": "two monitors, both at the streak, the newer check is shown", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 9 }], [{ "channelId": "a", "lastCheckedAt": 2000, "lastError": "timeout", "consecutiveErrors": 3 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 2000, "lastError": "timeout", "consecutiveErrors": 3 } } },
    { "name": "two monitors, both at the streak, the first list is newer", "monitors": [[{ "channelId": "a", "lastCheckedAt": 3000, "lastError": "404", "consecutiveErrors": 9 }], [{ "channelId": "a", "lastCheckedAt": 2000, "lastError": "timeout", "consecutiveErrors": 3 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 3000, "lastError": "404", "consecutiveErrors": 9 } } },
    { "name": "a tie in check time goes to the later list", "monitors": [[{ "channelId": "a", "lastCheckedAt": 2000, "lastError": "404", "consecutiveErrors": 9 }], [{ "channelId": "a", "lastCheckedAt": 2000, "lastError": "timeout", "consecutiveErrors": 3 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 2000, "lastError": "timeout", "consecutiveErrors": 3 } } },
    { "name": "a monitor that has not checked the channel says nothing", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 3 }], [{ "channelId": "b", "lastCheckedAt": 1000, "consecutiveErrors": 0 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 3 } } },
    { "name": "an empty second list", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 5 }], []], "want": { "a": { "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 5 } } },
    { "name": "several channels, only the failing ones", "monitors": [[{ "channelId": "a", "lastCheckedAt": 1000, "lastError": "404", "consecutiveErrors": 4 }, { "channelId": "b", "lastCheckedAt": 1000, "consecutiveErrors": 0 }, { "channelId": "c", "lastCheckedAt": 1000, "lastError": "500", "consecutiveErrors": 7 }], [{ "channelId": "a", "lastCheckedAt": 1500, "lastError": "no videos", "consecutiveErrors": 3 }, { "channelId": "b", "lastCheckedAt": 1500, "lastError": "timeout", "consecutiveErrors": 6 }, { "channelId": "c", "lastCheckedAt": 1500, "consecutiveErrors": 0 }]], "want": { "a": { "channelId": "a", "lastCheckedAt": 1500, "lastError": "no videos", "consecutiveErrors": 3 } } }
  ]
}
