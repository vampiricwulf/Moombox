{
    "name": "moombox-bgutil-sidecar",
    "version": "0.1.0",
    "description": "Stdin/stdout JSON-RPC server that runs BotGuard via bgutils-js + JSDOM. Bundled with esbuild and embedded into Moombox.exe so PO tokens generate without a user-installed Node.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node build.mjs",
        "smoke": "node src/server.js",
        "test": "node --test --test-force-exit test/minter-keying.test.mjs test/homepage-extract.test.mjs"
    },
    "dependencies": {
        "bgutils-js": "^4.0.3",
        "jsdom": "^30.0.1"
    },
    "devDependencies": {
        "astring": "1.9.0",
        "esbuild": "^0.28.1",
        "meriyah": "6.1.4"
    }
}
